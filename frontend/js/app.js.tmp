    try {
        const bookingsTable = document.getElementById('userBookingsTable');
        if (bookingsTable) {
            bookingsTable.innerHTML = `
                <tr>
                    <td>Базовий фітнес</td>
                    <td>2025-12-10</td>
                    <td>Сергій К.</td>
                    <td><span class="badge badge-success">✓ Підтверджено</span></td>
                    <td><button class="btn-sm btn-danger" onclick="cancelBooking()">Скасувати</button></td>
                </tr>
                <tr>
                    <td>Йога для початківців</td>
                    <td>2025-12-12</td>
                    <td>Марія П.</td>
                    <td><span class="badge badge-success">✓ Підтверджено</span></td>
                    <td><button class="btn-sm btn-danger" onclick="cancelBooking()">Скасувати</button></td>
                </tr>
            `;
        }
    } catch (error) {
