function bookService(serviceName, price) {
    const bookingDate = prompt(`Забронювати "${serviceName}" (₴${price})?\n\nОберіть дату (YYYY-MM-DD):`);
    if (bookingDate) {
        showNotification(`✅ Ви забронювали "${serviceName}" на ${bookingDate}`, 'success');
        loadUserBookings();
    }
}

